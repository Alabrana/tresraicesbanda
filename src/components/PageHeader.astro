---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="border-b border-border-subtle bg-surface-raised py-8 sm:py-9 md:py-10">
  <div class="tr-container-wide">
    {eyebrow && <p class="tr-eyebrow mb-2 text-text-secondary">{eyebrow}</p>}
    <h1 class="mb-0 text-[clamp(2.25rem,10vw,2.75rem)] leading-none font-bold md:text-[clamp(3rem,5vw,3.5rem)]">{title}</h1>
    {description && <p class="mt-3 mb-0 max-w-[48rem] text-base leading-relaxed text-text-secondary sm:mt-4">{description}</p>}
  </div>
</header>
