---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="border-b border-iron-700 bg-iron-900 py-7 sm:py-8 md:py-10">
  <div class="mx-auto w-full max-w-[70rem] px-4 sm:px-6 lg:px-8">
    {eyebrow && <p data-display-type class="mb-2 text-[0.8rem] font-bold tracking-[0.12em] text-ash-400 uppercase">{eyebrow}</p>}
    <h1 class="mb-0 text-[clamp(2rem,10vw,3rem)] leading-none font-bold md:text-[clamp(3rem,6vw,4rem)]">{title}</h1>
    {description && <p class="mt-3 mb-0 max-w-3xl text-sm text-ash-400 sm:mt-4 sm:text-base">{description}</p>}
  </div>
</header>
