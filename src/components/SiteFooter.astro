---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import SocialIcon from './SocialIcon.astro';
import { footerNavigation, site, siteIdentity } from '../data/content';

const currentYear = new Date().getFullYear();
const pressKitHref = '/downloads/tres-raices-logos-oficiales.zip';
const hasPressKit = existsSync(resolve(process.cwd(), 'public', pressKitHref.slice(1)));
const contactPhoneHref = `tel:${site.contactPhone.replace(/\s/g, '')}`;
---

<footer class="border-t border-border-subtle bg-surface-raised/35 text-text-secondary">
  <div class="tr-container-wide py-6 sm:py-8 lg:py-10">
    <section class="border-b border-border-subtle pb-4 text-center sm:text-left" aria-labelledby="footer-identity-heading">
      <p class="m-0 font-[var(--font-display)] text-sm font-bold tracking-[0.1em] text-accent-interactive">
        {siteIdentity.locationLabel}
      </p>
      <h2 id="footer-identity-heading" class="mt-1 mb-0 text-[1.75rem] leading-none text-text-primary sm:text-[2rem]">
        {siteIdentity.statement}
      </h2>
      <p class="mx-auto mt-1 mb-0 max-w-xl text-base leading-snug text-text-secondary sm:mx-0">
        {siteIdentity.descriptor}
      </p>
      <div class="mx-auto mt-2 flex h-1 w-48 items-center gap-1 sm:mx-0" aria-hidden="true">
        <span class="h-[3px] w-24 bg-accent-interactive"></span>
        <span class="h-px w-9 bg-accent-interactive/75"></span>
        <span class="h-[2px] w-5 bg-accent-interactive/45"></span>
        <span class="h-px w-2 bg-accent-interactive/30"></span>
      </div>
    </section>

    <div class="grid gap-4 py-4 sm:grid-cols-[auto_auto] sm:justify-between sm:gap-12">
      <nav class="text-center sm:text-left" aria-labelledby="footer-navigation-heading">
        <h2 id="footer-navigation-heading" class="mb-1 text-base leading-none text-text-primary">EXPLORA</h2>
        <ul class="mx-auto grid w-72 max-w-full grid-cols-2 gap-x-6 gap-y-1 p-0 sm:mx-0" role="list">
          {footerNavigation.map(({ label, href }) => (
            <li>
              <a class="inline-flex min-h-9 items-center justify-center text-base leading-tight text-text-secondary no-underline transition-colors hover:text-accent-interactive sm:justify-start" href={href}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section class="text-center sm:justify-self-end sm:text-right" aria-labelledby="footer-contact-heading">
        <h2 id="footer-contact-heading" class="mb-1 text-base leading-none text-text-primary">PRENSA Y CONTACTO</h2>
        <a class="inline-flex min-h-9 w-full items-center justify-center text-base leading-tight text-text-secondary underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent-interactive sm:justify-end" href={`mailto:${site.contactEmail}`}>
          {site.contactEmail}
        </a>
        <a class="inline-flex min-h-8 w-full items-center justify-center text-base leading-tight text-text-secondary no-underline transition-colors hover:text-accent-interactive sm:justify-end" href={contactPhoneHref}>
          {site.contactPhone}
        </a>

        {hasPressKit && (
          <div class="mt-1 flex flex-col items-center sm:items-end">
            <a
              class="group inline-grid min-h-9 grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-x-3 text-accent-interactive no-underline transition-colors hover:text-text-primary"
              href={pressKitHref}
              download
            >
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
                <path d="M12 3v11m0 0 4-4m-4 4-4-4" />
                <path d="M5 14v5h14v-5" />
              </svg>
              <span class="font-[var(--font-display)] text-base font-bold tracking-[0.02em] underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-current">
                logos oficiales .zip
              </span>
            </a>
          </div>
        )}
      </section>
    </div>

    <div>
      <ul class="flex flex-wrap items-center justify-center gap-2 p-0 sm:gap-3" role="list" aria-label={`${siteIdentity.name} en redes sociales y contacto`}>
        {site.socialLinks.map((socialLink) => (
          <li>
            <a
              class="inline-flex size-11 items-center justify-center border border-transparent text-text-primary transition-colors hover:border-border-strong hover:text-accent-interactive"
              href={socialLink.url}
              target="_blank"
              rel="noopener noreferrer"
              title={socialLink.name}
              aria-label={`${socialLink.name} de ${siteIdentity.name} (sitio externo)`}
            >
              <SocialIcon id={socialLink.id} />
            </a>
          </li>
        ))}
        <li>
          <a
            class="inline-flex size-11 items-center justify-center border border-transparent text-text-primary transition-colors hover:border-border-strong hover:text-accent-interactive"
            href={`mailto:${site.contactEmail}`}
            title="Correo"
            aria-label={`Enviar correo a ${site.contactEmail}`}
          >
            <SocialIcon id="email" />
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-3 flex flex-col items-center gap-1 border-t border-border-subtle pt-3 text-center text-sm leading-snug tracking-[0.02em]">
      <p class="m-0">© {currentYear} {siteIdentity.name} · {siteIdentity.location}</p>
      <p class="m-0 text-text-secondary/85">
        Desarrollado por{' '}
        <a
          class="text-text-secondary underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent-interactive"
          href="https://www.instagram.com/mardigitalinformatica/"
          target="_blank"
          rel="noopener noreferrer"
        >Mar Digital_</a>
      </p>
    </div>
  </div>
</footer>
