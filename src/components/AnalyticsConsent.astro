<aside
  class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-[34rem] border border-border-strong bg-surface-raised/98 p-4 shadow-2xl backdrop-blur-sm sm:inset-x-5 sm:bottom-5 sm:p-5"
  data-analytics-consent
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  hidden
>
  <p class="tr-eyebrow">Privacidad</p>
  <h2 id="analytics-consent-title" class="m-0 text-xl leading-none text-text-primary uppercase sm:text-2xl">Analítica del sitio</h2>
  <p id="analytics-consent-description" class="mt-3 mb-0 text-sm leading-relaxed text-text-secondary sm:text-base">
    Podemos usar Google Analytics para entender las visitas y mejorar esta web. Solo se activa si aceptas; no usamos esta decisión para publicidad.
  </p>
  <p class="sr-only" aria-live="polite" data-analytics-consent-status></p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button class="tr-button-primary" type="button" data-analytics-accept>Aceptar</button>
    <button class="tr-button-secondary" type="button" data-analytics-reject>Rechazar</button>
  </div>
</aside>

<script>
  const consentPanel = document.querySelector<HTMLElement>('[data-analytics-consent]');
  const acceptButton = consentPanel?.querySelector<HTMLButtonElement>('[data-analytics-accept]');
  const rejectButton = consentPanel?.querySelector<HTMLButtonElement>('[data-analytics-reject]');
  const consentStatus = consentPanel?.querySelector<HTMLElement>('[data-analytics-consent-status]');

  function openConsentPanel() {
    if (!consentPanel) return;
    consentPanel.hidden = false;
    acceptButton?.focus();
  }

  function closeConsentPanel(message: string) {
    if (!consentPanel) return;
    consentPanel.hidden = true;
    if (consentStatus) consentStatus.textContent = message;
  }

  if (window.tresRaicesAnalytics?.getPreference() === null) {
    openConsentPanel();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-analytics-settings]').forEach((button) => {
    button.addEventListener('click', openConsentPanel);
  });

  acceptButton?.addEventListener('click', () => {
    window.tresRaicesAnalytics?.accept();
    closeConsentPanel('Preferencia guardada: analítica aceptada.');
  });

  rejectButton?.addEventListener('click', () => {
    window.tresRaicesAnalytics?.reject();
    closeConsentPanel('Preferencia guardada: analítica rechazada.');
  });
</script>

