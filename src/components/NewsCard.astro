---
import type { CollectionEntry } from 'astro:content';
import { formatCivilDate } from '../lib/civil-date';

interface Props {
  article: CollectionEntry<'news'>;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const href = `/news/${article.id}/`;
---

<article class:list={[
  'group min-w-0 overflow-hidden border border-border-subtle bg-surface-raised',
  featured && 'md:mx-auto md:max-w-[60rem]',
]}>
  <div class:list={['min-w-0', featured && 'grid sm:grid-cols-[minmax(10rem,0.7fr)_1fr] md:grid-cols-[minmax(15rem,19rem)_1fr]']}>
    <a
      class:list={[
        'block overflow-hidden bg-surface-canvas',
        featured ? 'aspect-[4/5] sm:h-full sm:aspect-auto md:max-h-[27rem]' : 'aspect-[4/5]',
      ]}
      href={href}
      aria-label={`Leer: ${article.data.title}`}
    >
      <img
        class="h-full w-full object-contain"
        src={article.data.cover}
        width="1200"
        height="900"
        alt={`Portada: ${article.data.title}`}
        loading={featured ? 'eager' : 'lazy'}
      />
    </a>
    <div class="min-w-0 p-4 sm:p-5">
      <time data-display-type class:list={['mb-2 block text-accent-interactive uppercase', featured ? 'text-sm tracking-[0.08em]' : 'text-xs tracking-[0.1em]']} datetime={article.data.date}>{formatCivilDate(article.data.date)}</time>
      <h2 class:list={['mb-3 leading-none font-bold uppercase', featured ? 'text-2xl sm:text-3xl' : 'text-2xl']}>
        <a class="text-ash-100 no-underline transition-colors hover:text-accent-interactive" href={href}>{article.data.title}</a>
      </h2>
      <p class="mb-4 text-sm text-ash-400 sm:text-base">{article.data.summary}</p>
      <a class="inline-flex min-h-11 items-center text-sm font-bold tracking-[0.04em] text-ash-100 no-underline transition-colors hover:text-accent-interactive hover:underline hover:underline-offset-4" href={href}>
        Leer noticia <span class="ml-2" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
