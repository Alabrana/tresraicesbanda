---
import type { Show } from '../lib/contracts';
import { formatCivilDate } from '../lib/civil-date';

interface Props {
  show: Show;
  showId?: string;
  featured?: boolean;
  showTicket?: boolean;
}

const { show, showId, featured = false, showTicket = true } = Astro.props;
const statusLabel = show.status === 'cancelled' ? 'Cancelada' : show.status === 'rescheduled' ? 'Reprogramada' : null;
const descriptionParagraphs = show.description
  ?.split(/\r?\n\s*\r?\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<article class:list={['relative min-w-0 overflow-hidden border border-border-subtle bg-surface-raised', featured && 'border-l-2 border-l-accent-petrol md:mx-auto md:max-w-[60rem]']} data-show-card={showId}>
  {statusLabel && (
    <p class="absolute top-5 -right-10 z-10 m-0 w-40 rotate-45 border-y border-ash-100/45 bg-coal-950/95 py-1 text-center text-xs font-bold tracking-[0.1em] text-ash-100 uppercase">
      {statusLabel}
    </p>
  )}
  <div class:list={['grid min-w-0 sm:grid-cols-[minmax(10rem,0.7fr)_1fr]', featured && 'md:grid-cols-[minmax(15rem,19rem)_1fr]']}>
    <div class:list={['aspect-[4/5] bg-surface-canvas sm:h-full sm:aspect-auto', featured && 'md:max-h-[27rem]']}>
      <img class="h-full w-full object-contain" src={show.poster} width="1200" height="900" alt={`Afiche de ${show.title}`} loading="lazy" />
    </div>
    <div class="min-w-0 p-4 sm:p-5">
      <p data-display-type class="mb-2 text-sm tracking-[0.08em] text-accent-interactive uppercase">{formatCivilDate(show.date)} · {show.time}</p>
      <h3 class="mb-2 text-2xl leading-none font-bold uppercase sm:text-3xl">{show.title}</h3>
      <p class="mb-1 text-sm text-ash-100 sm:text-base">{show.venue} · {show.city}</p>
      {show.address && <p class="mb-3 text-sm text-ash-400">{show.address}</p>}
      {descriptionParagraphs && descriptionParagraphs.length > 0 && (
        <div class="mb-3 space-y-3 text-sm text-ash-400">
          {descriptionParagraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
        </div>
      )}
      {show.guestBands && show.guestBands.length > 0 && <p class="mb-3 text-sm text-ash-400">Junto a {show.guestBands.join(', ')}.</p>}
      {showTicket && show.ticketUrl && show.status === 'scheduled' && (
        <a class="tr-button-primary px-4" href={show.ticketUrl} target="_blank" rel="noreferrer" data-show-ticket>
          Entradas <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>
