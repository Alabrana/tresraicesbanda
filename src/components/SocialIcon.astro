---
import type { SiteSocialLink } from '../lib/contracts';

interface Props {
  id: SiteSocialLink['id'] | 'email';
}

const { id } = Astro.props;
---

{id === 'instagram' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="size-6">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
  </svg>
)}
{id === 'facebook' && (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-6">
    <path d="M13.5 21v-8h2.75l.5-3h-3.25V8.05c0-.87.29-1.46 1.58-1.46H17V3.92A19.4 19.4 0 0 0 14.94 3c-2.04 0-3.44 1.25-3.44 3.53V10H9v3h2.5v8h2Z" />
  </svg>
)}
{id === 'youtube' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="size-6">
    <path d="M21 12c0 2.78-.32 4.55-.64 5.55a2.55 2.55 0 0 1-1.81 1.81C17.55 19.68 15.78 20 12 20s-5.55-.32-6.55-.64a2.55 2.55 0 0 1-1.81-1.81C3.32 16.55 3 14.78 3 12s.32-4.55.64-5.55a2.55 2.55 0 0 1 1.81-1.81C6.45 4.32 8.22 4 12 4s5.55.32 6.55.64a2.55 2.55 0 0 1 1.81 1.81C20.68 7.45 21 9.22 21 12Z" />
    <path d="m10 9 5 3-5 3V9Z" fill="currentColor" stroke="none" />
  </svg>
)}
{id === 'tiktok' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="size-6">
    <path d="M14 3v10.25A4.75 4.75 0 1 1 10 8.56V11a2.4 2.4 0 1 0 1.6 2.25V3h2.4c.36 2.2 1.68 3.56 3.75 3.9v2.32A6.85 6.85 0 0 1 14 8.07V3Z" fill="currentColor" stroke="none" />
  </svg>
)}
{id === 'email' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="size-6">
    <rect x="3" y="5" width="18" height="14" rx="1" />
    <path d="m4 7 8 6 8-6" />
  </svg>
)}
