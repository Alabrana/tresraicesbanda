---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ibmPlexSansUrl from '../assets/fonts/ibm-plex-sans-400-latin.woff2?url';
import oswaldUrl from '../assets/fonts/oswald-700-latin.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Sitio oficial de Tres Raíces, rock desde Talcahuano.',
  noIndex = false,
  image = '/images/logos/tres-raices-oficial.png',
  imageAlt = 'Tres Raíces',
  ogType = 'website',
} = Astro.props;
const publicBaseUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, publicBaseUrl);
const imageUrl = new URL(image, publicBaseUrl);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Tres Raíces" />
    <meta property="og:title" content={`${title} | Tres Raíces`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Tres Raíces`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={oswaldUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={ibmPlexSansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/webp" href="/images/logos/logoredondo.webp" />
    <title>{title} | Tres Raíces</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
