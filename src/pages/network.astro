---
import PageHeader from '../components/PageHeader.astro';
import { network } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';

const bands = network.bands.filter((band) => band.visible);
---

<BaseLayout title="Network">
  <PageHeader eyebrow="Bandas amigas" title="Network" description="Vínculos de la escena y bandas amigas." />
  <section class="mx-auto min-h-[48vh] w-full max-w-[70rem] px-4 pt-8 pb-12 sm:px-6 sm:pt-10 sm:pb-16 lg:px-8 lg:pt-12 lg:pb-20">
    {bands.length === 0 ? (
      <p class="mb-0 max-w-[46rem] border border-iron-700 bg-iron-900 p-4 text-sm text-ash-400 sm:p-6 sm:text-base">Las bandas amigas se incorporarán cuando sus datos y logos sean confirmados.</p>
    ) : (
      <ul class="grid grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" role="list">
        {bands.map((band) => (
          <li class="min-w-0 border border-iron-700 bg-iron-900">
            {band.url ? (
              <a class="group flex min-h-52 flex-col items-center justify-center gap-4 p-5 text-center no-underline transition-colors hover:bg-iron-700/35" href={band.url} target="_blank" rel="noreferrer" aria-label={`${band.name} (sitio externo)`}>
                <img class="max-h-28 max-w-full object-contain" src={band.logo} alt={band.name} loading="lazy" />
                <span class="text-sm font-bold text-ash-100 transition-colors group-hover:text-petrol-500">{band.name} <span aria-hidden="true">↗</span></span>
              </a>
            ) : (
              <div class="flex min-h-52 flex-col items-center justify-center gap-4 p-5 text-center">
                <img class="max-h-28 max-w-full object-contain" src={band.logo} alt={band.name} loading="lazy" />
                <p class="mb-0 text-sm font-bold text-ash-100">{band.name}</p>
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
