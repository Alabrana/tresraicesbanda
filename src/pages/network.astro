---
import PageHeader from '../components/PageHeader.astro';
import { network, site } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../lib/seo';

const bands = network.bands.filter((band) => {
  if (!band.visible) return false;
  const isPlaceholderName = /^nombre de la banda/i.test(band.name.trim());
  const isPlaceholderUrl = band.url ? new URL(band.url).hostname === 'ejemplo.cl' : false;
  return !isPlaceholderName && !isPlaceholderUrl;
});
---

<BaseLayout {...pageSeo.network}>
  <PageHeader eyebrow="Bandas amigas" title="Network" description="Vínculos de la escena y bandas amigas." />
  <section class="tr-container-editorial tr-section-standard">
    {bands.length === 0 ? (
      <p class="mb-0 max-w-[46rem] border border-iron-700 bg-iron-900 p-4 text-sm text-ash-400 sm:p-6 sm:text-base">Las bandas amigas se incorporarán cuando sus datos y logos sean confirmados.</p>
    ) : (
      <ul class="flex flex-wrap justify-center gap-x-2 gap-y-6 p-0 sm:gap-x-3" role="list">
        {bands.map((band) => (
          <li class="network-item w-40 min-w-0 sm:w-48">
            {band.url ? (
              <a class="group flex min-h-40 flex-col items-center justify-center gap-3 p-3 text-center no-underline" href={band.url} target="_blank" rel="noreferrer" aria-label={`${band.name} (sitio externo)`}>
                <span class="flex h-[6.3rem] w-full items-center justify-center">
                  <img class="network-logo max-h-full max-w-[90%] object-contain" src={band.logo} alt={band.name} loading="lazy" />
                </span>
                <span class="text-sm font-bold text-ash-100 transition-colors group-hover:text-accent-interactive">{band.name}</span>
              </a>
            ) : (
              <div class="flex min-h-40 flex-col items-center justify-center gap-3 p-3 text-center">
                <span class="flex h-[6.3rem] w-full items-center justify-center">
                  <img class="network-logo max-h-full max-w-[90%] object-contain" src={band.logo} alt={band.name} loading="lazy" />
                </span>
                <p class="mb-0 text-sm font-bold text-ash-100">{band.name}</p>
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
    <p class="mt-10 mb-0 text-center text-xs leading-relaxed text-text-secondary/85">
      ¿Quieres ser parte de nuestra red de amigos?{' '}
      <a class="underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent-interactive" href={`mailto:${site.contactEmail}`}>Contáctanos.</a>
    </p>
  </section>
</BaseLayout>

<style>
  .network-logo {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .network-item:hover .network-logo,
  .network-item:focus-within .network-logo {
    transform: translateY(-0.25rem) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .network-logo {
      transition: none;
    }

    .network-item:hover .network-logo,
    .network-item:focus-within .network-logo {
      transform: none;
    }
  }
</style>
