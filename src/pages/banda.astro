---
import PageHeader from '../components/PageHeader.astro';
import { band } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="La Banda">
  <PageHeader eyebrow="Tres Raíces" title="La Banda" description="Tres músicos de Talcahuano. Historia y biografías pendientes de contenido confirmado." />
  <section class="mx-auto min-h-[48vh] w-full max-w-[70rem] px-4 pt-8 pb-12 sm:px-6 sm:pt-10 sm:pb-16 lg:px-8 lg:pt-12 lg:pb-20">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:gap-6">
      {band.members.map((member) => (
        <article class="min-w-0 border border-iron-700 bg-iron-900 p-4 sm:p-5">
          <img class="mb-4 aspect-3/4 object-cover" src={member.photo} width="768" height="1024" alt={`${member.name}, ${member.instrument}`} />
          <h2 class="mb-1 text-xl font-bold sm:text-2xl">{member.name}</h2>
          <p class="mb-3 text-sm text-ash-400 sm:mb-4 sm:text-base">{member.instrument}</p>
          {!member.bio && <p class="mb-0 text-sm text-ash-400 sm:text-base">Biografía pendiente de confirmación.</p>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
