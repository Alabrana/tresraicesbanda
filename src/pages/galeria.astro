---
import PageHeader from '../components/PageHeader.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import { gallery } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../lib/seo';

const photos = gallery.photos.filter((photo) => photo.visible);
---

<BaseLayout {...pageSeo.gallery}>
  <PageHeader title="Galería" description="Fotografías seleccionadas de Tres Raíces." />
  <section class="tr-container-editorial tr-section-standard">
    {photos.length === 0 ? (
      <p class="mb-0 max-w-[46rem] border border-iron-700 bg-iron-900 p-4 text-sm text-ash-400 sm:p-6 sm:text-base">La selección de fotografías está pendiente.</p>
    ) : <GalleryLightbox photos={photos} />}
  </section>
</BaseLayout>
