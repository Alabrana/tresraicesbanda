---
import BaseLayout from '../layouts/BaseLayout.astro';
import GrungeDivider from '../components/GrungeDivider.astro';
import NewsCard from '../components/NewsCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ShowCard from '../components/ShowCard.astro';
import ShowClassificationState from '../components/ShowClassificationState.astro';
import ShowHistoryRow from '../components/ShowHistoryRow.astro';
import VideoModal from '../components/VideoModal.astro';
import { band, collaborators, gallery, media, site } from '../data/content';
import { getCollection } from 'astro:content';
import { classifyShows, getHomeShowSelection } from '../lib/events';
import { pageSeo, siteSeo, toAbsoluteUrl } from '../lib/seo';

const [articles, showEntries] = await Promise.all([getCollection('news'), getCollection('shows')]);
const shows = showEntries.map((show) => show.data);
const showClassification = classifyShows(shows);
const homeShows = getHomeShowSelection(showClassification);
const shortShowDateFormatter = new Intl.DateTimeFormat('es-CL', {
  day: '2-digit',
  month: 'short',
  timeZone: 'UTC',
});
const formatShortShowDate = (date: string) => shortShowDateFormatter
  .format(new Date(`${date}T12:00:00Z`))
  .replace(/[.-]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .toLocaleUpperCase('es-CL');
const latestArticle = [...articles].sort((left, right) => right.data.date.localeCompare(left.data.date))[0];
const latestVideo = media.videos
  .filter((video) => video.visible)
  .sort((left, right) => (right.date ?? '').localeCompare(left.date ?? ''))[0];
const galleryPreview = gallery.photos.filter((photo) => photo.visible).slice(0, 3);
const visibleCollaborators = collaborators.collaborators.filter((collaborator) => {
  if (!collaborator.visible) return false;
  const isPlaceholderName = /^nombre del colaborador/i.test(collaborator.name.trim());
  const isPlaceholderUrl = collaborator.url ? new URL(collaborator.url).hostname === 'ejemplo.cl' : false;
  return !isPlaceholderName && !isPlaceholderUrl;
});
const hasBandPreview = Boolean(band.intro && band.groupPhoto);
const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': siteSeo.websiteId,
  url: siteSeo.url,
  name: siteSeo.name,
  inLanguage: siteSeo.lang,
  publisher: { '@id': siteSeo.musicGroupId },
};
const musicGroupJsonLd = {
  '@type': 'MusicGroup',
  '@id': siteSeo.musicGroupId,
  name: siteSeo.name,
  url: siteSeo.url,
  description: 'Banda de rock oriunda de Talcahuano, Chile.',
  genre: 'Rock',
  email: site.contactEmail,
  foundingLocation: {
    '@type': 'Place',
    name: 'Talcahuano, Chile',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Talcahuano',
      addressCountry: 'CL',
    },
  },
  logo: toAbsoluteUrl('/images/logos/logoredondo.webp'),
  image: toAbsoluteUrl(band.groupPhoto),
  sameAs: site.socialLinks.map((socialLink) => socialLink.url),
  member: band.members.map((member) => ({
    '@type': 'Person',
    name: member.name,
    description: member.instrument,
  })),
};
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [websiteJsonLd, musicGroupJsonLd],
};
---

<BaseLayout {...pageSeo.home} structuredData={homeStructuredData}>
  {shows.length > 0 && <ShowClassificationState scope="home" shows={shows} />}
  <section class="relative isolate flex min-h-[32rem] items-center overflow-hidden border-b border-border-subtle md:min-h-[36rem] lg:min-h-[38rem]">
    <ResponsiveImage
      class="absolute inset-0 -z-30 size-full object-cover object-[68%_42%] sm:object-[62%_42%] lg:object-[center_42%]"
      src={band.groupPhoto}
      sizes="100vw"
      alt=""
      aria-hidden="true"
      priority
    />
    <div class="absolute inset-0 -z-20 bg-surface-canvas/35" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-20 bg-accent-petrol/10" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(16,18,19,0.96)_0%,rgba(16,18,19,0.86)_42%,rgba(16,18,19,0.48)_72%,rgba(16,18,19,0.34)_100%)] sm:bg-[linear-gradient(90deg,rgba(16,18,19,0.96)_0%,rgba(16,18,19,0.84)_46%,rgba(16,18,19,0.4)_76%,rgba(16,18,19,0.3)_100%)]" aria-hidden="true"></div>
    <div class="tr-container-wide py-10 sm:py-12 md:py-14 lg:py-16">
      <div class="max-w-[43rem] text-left">
        <p class="tr-eyebrow mb-3 text-text-primary">Talcahuano · Chile</p>
        <h1 class="mb-4 max-w-[9ch] text-[clamp(2.75rem,12vw,3.25rem)] leading-[0.92] font-bold uppercase sm:text-[clamp(3.25rem,9vw,4rem)] lg:text-[clamp(4rem,5.4vw,5rem)]">
          <span class="block">Rock &amp;</span>
          <span class="block">Roll del puerto</span>
        </h1>
        <p class="mb-6 max-w-[38rem] text-[1.0625rem] leading-relaxed text-text-primary md:text-lg">La misma raíz. Ruido de puerto, Mar y de nuestro territorio.</p>
        <div class="flex flex-wrap gap-3">
          <a class="tr-button-primary" href="/en-vivo/">Ver fechas</a>
          <a class="tr-button-secondary bg-surface-canvas/45" href="/media/">Escuchar y mirar</a>
        </div>
        <div
          class="mt-6 border-l-2 border-accent-interactive/80 pl-3"
          data-home-hero-live
          data-show-dynamic
          hidden={!homeShows.featured}
        >
          <p class="mb-1 text-xs tracking-[0.1em] text-text-secondary uppercase" data-display-type>Próxima fecha</p>
          <div data-home-hero-live-value>
            {homeShows.featured && (
              <p class="text-sm leading-snug text-text-primary sm:text-[0.9375rem]">
                <time datetime={homeShows.featured.date}>{formatShortShowDate(homeShows.featured.date)}</time>
                <span aria-hidden="true"> · </span>{homeShows.featured.venue}
                <span aria-hidden="true"> · </span>{homeShows.featured.city}
              </p>
            )}
          </div>
        </div>
        {shows.map((show) => (
          <template data-home-hero-show-template={show.id}>
            <p class="text-sm leading-snug text-text-primary sm:text-[0.9375rem]">
              <time datetime={show.date}>{formatShortShowDate(show.date)}</time>
              <span aria-hidden="true"> · </span>{show.venue}
              <span aria-hidden="true"> · </span>{show.city}
            </p>
          </template>
        ))}
      </div>
    </div>
  </section>

  {shows.length > 0 && (
    <section
      class="tr-container-editorial tr-section-featured"
      data-home-live
      data-show-dynamic
      hidden={!homeShows.featured && homeShows.past.length === 0}
    >
      <div class="mb-4 flex items-end justify-between gap-4 sm:mb-5">
        <div>
          <p class="tr-eyebrow">En vivo</p>
          <h2 class="tr-section-title">Próxima fecha</h2>
          <GrungeDivider class="mt-2" width="medium" />
        </div>
        <a class="tr-text-link" href="/en-vivo/">Ver todas <span aria-hidden="true">→</span></a>
      </div>
      <div data-home-live-card hidden={!homeShows.featured}>
        {homeShows.featured && <ShowCard show={homeShows.featured} featured />}
      </div>
      <p
        class="border border-iron-700 bg-iron-900 p-4 text-sm text-ash-400 sm:p-6 sm:text-base"
        data-home-live-empty
        hidden={Boolean(homeShows.featured)}
      >
        No hay una próxima fecha confirmada por ahora.
      </p>
      {shows.map((show) => (
        <template data-home-show-template={show.id}><ShowCard show={show} featured /></template>
      ))}
      <div class="mt-8 border-t border-border-subtle pt-8 sm:mt-10 sm:pt-10" data-home-upcoming hidden={homeShows.upcoming.length === 0}>
        <div class="mb-4 sm:mb-5">
          <h3 class="text-xl leading-none uppercase sm:text-2xl" id="home-upcoming-shows-title">Próximas presentaciones</h3>
          <GrungeDivider class="mt-2" width="medium" />
        </div>
        <div class="space-y-2.5" data-home-upcoming-list aria-labelledby="home-upcoming-shows-title">
          {homeShows.upcoming.map((show) => <ShowHistoryRow show={show} />)}
        </div>
      </div>
      <div class="mt-8 border-t border-border-subtle pt-8 sm:mt-10 sm:pt-10" data-home-history hidden={homeShows.past.length === 0}>
        <div class="mb-4 sm:mb-5">
          <h3 class="text-xl leading-none uppercase sm:text-2xl" id="home-past-shows-title">Presentaciones anteriores</h3>
          <GrungeDivider class="mt-2" width="medium" />
        </div>
        <div aria-labelledby="home-past-shows-title">
          <div class="space-y-2.5" data-home-history-list>
            {homeShows.past.map((show) => <ShowHistoryRow show={show} />)}
          </div>
        </div>
        <a class="tr-text-link mt-3 inline-flex min-h-11 items-center" href="/en-vivo/" data-home-history-link hidden={!homeShows.hasMorePast}>
          Ver todas las presentaciones <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
      {shows.map((show) => (
        <template data-home-list-show-template={show.id}><ShowHistoryRow show={show} /></template>
      ))}
    </section>
  )}

  {latestVideo && (
    <section class="border-y border-border-subtle bg-surface-raised/60">
      <div class="tr-container-editorial tr-section-featured">
        <div class="text-center">
          <p class="tr-eyebrow">Media</p>
          <h2 class="tr-section-title mb-5">Último video</h2>
        </div>
        <VideoModal videos={[latestVideo]} featured />
        <div class="mt-5 text-center"><a class="tr-button-secondary" href="/media/">Ver Media <span class="ml-2" aria-hidden="true">→</span></a></div>
      </div>
    </section>
  )}

  {hasBandPreview && (
    <section class="tr-container-editorial tr-section-standard">
      <div class="grid gap-6 md:grid-cols-[minmax(16rem,0.85fr)_1fr] md:items-center md:gap-10">
        <ResponsiveImage class="aspect-4/3 w-full object-cover" src={band.groupPhoto} sizes="(min-width: 1024px) 432px, (min-width: 768px) 42vw, calc(100vw - 2rem)" alt="Tres Raíces" loading="lazy" />
        <div>
          <p class="tr-eyebrow">La Banda</p>
          <h2 class="tr-section-title">Tres Raíces</h2>
          <GrungeDivider class="mt-2 mb-4" width="short" />
          <p class="mb-5 max-w-[58ch] text-base leading-relaxed text-text-secondary">{band.intro}</p>
          <a class="tr-button-secondary" href="/banda/">Conocer a la banda <span class="ml-2" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  )}

  {latestArticle && (
    <section class="border-y border-border-subtle">
      <div class="tr-container-editorial tr-section-featured">
        <div class="mb-4 flex items-end justify-between gap-4 sm:mb-5">
          <div>
            <p class="tr-eyebrow">News</p>
            <h2 class="tr-section-title">Última noticia</h2>
            <GrungeDivider class="mt-2" width="long" />
          </div>
          <a class="tr-text-link" href="/news/">Ver todas <span aria-hidden="true">→</span></a>
        </div>
        <NewsCard article={latestArticle} featured />
      </div>
    </section>
  )}

  {galleryPreview.length > 0 && (
    <section class="tr-container-editorial tr-section-standard">
      <div class="mb-4 flex items-end justify-between gap-4 sm:mb-5">
        <div>
          <p class="tr-eyebrow">Galería</p>
          <h2 class="tr-section-title">Momentos</h2>
        </div>
        <a class="tr-text-link" href="/galeria/">Ver galería <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid justify-items-center gap-4 sm:grid-cols-3 sm:gap-5">
        {galleryPreview.map((photo) => (
          <div class="aspect-[3/4] w-full max-w-[21rem] overflow-hidden bg-surface-canvas sm:max-w-none">
            <ResponsiveImage class="size-full object-cover" src={photo.image} sizes="(min-width: 640px) 33vw, calc(100vw - 2rem)" alt={photo.description} loading="lazy" />
          </div>
        ))}
      </div>
    </section>
  )}

  {visibleCollaborators.length > 0 && (
    <section class="border-t border-border-subtle bg-surface-raised/60">
      <div class="tr-container-wide tr-section-compact">
        <p data-display-type class="mb-4 text-center text-xs tracking-[0.12em] text-ash-400 uppercase">Colaboran</p>
        <div class="flex flex-wrap items-center justify-center gap-5 sm:gap-8">
          {visibleCollaborators.map((collaborator) => collaborator.url ? (
            <a class="group" href={collaborator.url} target="_blank" rel="noreferrer" aria-label={`${collaborator.name} (sitio externo)`}><img class="max-h-16 w-auto object-contain opacity-30 grayscale brightness-50 transition-[filter,opacity] duration-300 group-hover:opacity-100 group-hover:grayscale-0 group-hover:brightness-100 group-focus-visible:opacity-100 group-focus-visible:grayscale-0 group-focus-visible:brightness-100" src={collaborator.logo} alt={collaborator.name} loading="lazy" /></a>
          ) : <img class="max-h-16 w-auto object-contain opacity-30 grayscale brightness-50 transition-[filter,opacity] duration-300 hover:opacity-100 hover:grayscale-0 hover:brightness-100" src={collaborator.logo} alt={collaborator.name} loading="lazy" />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { classifyShows, getHomeShowSelection, type ClassifiableShow, type ShowClassification } from '../lib/events';

  const homeLive = document.querySelector<HTMLElement>('[data-home-live]');
  const heroLive = document.querySelector<HTMLElement>('[data-home-hero-live]');
  const source = document.querySelector<HTMLScriptElement>('[data-show-classification-source][data-scope="home"]');

  if (source) {
    const shows = JSON.parse(source.textContent ?? '[]') as ClassifiableShow[];
    const render = (classification: ShowClassification<ClassifiableShow>) => {
      const selection = getHomeShowSelection(classification);
      const nextShow = selection.featured;

      if (heroLive) {
        const value = heroLive.querySelector<HTMLElement>('[data-home-hero-live-value]');
        const template = nextShow ? document.querySelector<HTMLTemplateElement>(`[data-home-hero-show-template="${nextShow.id}"]`) : null;
        if (value && template) value.replaceChildren(template.content.cloneNode(true));
        heroLive.hidden = !nextShow;
      }

      if (homeLive) {
        const card = homeLive.querySelector<HTMLElement>('[data-home-live-card]');
        const emptyState = homeLive.querySelector<HTMLElement>('[data-home-live-empty]');
        const template = nextShow ? homeLive.querySelector<HTMLTemplateElement>(`[data-home-show-template="${nextShow.id}"]`) : null;
        if (card && template) card.replaceChildren(template.content.cloneNode(true));
        if (card) card.hidden = !nextShow;
        if (emptyState) emptyState.hidden = Boolean(nextShow);

        const upcoming = homeLive.querySelector<HTMLElement>('[data-home-upcoming]');
        const upcomingList = homeLive.querySelector<HTMLElement>('[data-home-upcoming-list]');
        const history = homeLive.querySelector<HTMLElement>('[data-home-history]');
        const historyList = homeLive.querySelector<HTMLElement>('[data-home-history-list]');
        const historyLink = homeLive.querySelector<HTMLElement>('[data-home-history-link]');

        const listNodes = (items: ClassifiableShow[]) => items.flatMap((show) => {
          const listTemplate = homeLive.querySelector<HTMLTemplateElement>(`[data-home-list-show-template="${show.id}"]`);
          return listTemplate ? [listTemplate.content.cloneNode(true)] : [];
        });

        if (upcomingList) upcomingList.replaceChildren(...listNodes(selection.upcoming));
        if (upcoming) upcoming.hidden = selection.upcoming.length === 0;
        if (historyList) historyList.replaceChildren(...listNodes(selection.past));
        if (history) history.hidden = selection.past.length === 0;
        if (historyLink) historyLink.hidden = !selection.hasMorePast;
        homeLive.hidden = !nextShow && selection.past.length === 0;
      }

      delete document.documentElement.dataset.showsPending;
    };

    render(classifyShows(shows));
    document.addEventListener('tres-raices:shows-classified', ((event: CustomEvent<ShowClassification<ClassifiableShow>>) => render(event.detail)) as EventListener);
  }
</script>
