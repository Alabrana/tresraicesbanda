---
import BaseLayout from '../layouts/BaseLayout.astro';
import { band, collaborators, gallery, media, network, site } from '../data/content';
import { getCollection } from 'astro:content';

await Promise.all([getCollection('news'), getCollection('shows')]);
void [band, collaborators, gallery, media, network, site];
---

<BaseLayout title="Inicio">
  <section class="border-b border-iron-700 py-8 sm:py-10 md:py-14 lg:py-16">
    <div class="mx-auto grid w-full max-w-[70rem] items-center gap-6 px-4 sm:px-6 md:grid-cols-[minmax(220px,0.75fr)_1fr] md:gap-10 lg:gap-16 lg:px-8">
      <img class="mx-auto h-auto w-full max-w-56 sm:max-w-64 md:max-w-none" src="/images/logos/tres-raices-oficial.png" width="900" height="540" alt="Tres Raíces" />
      <div class="text-center md:text-left">
        <p data-display-type class="mb-2 text-[0.8rem] font-bold tracking-[0.12em] text-ash-400 uppercase">Talcahuano · Chile</p>
        <h1 class="mx-auto mb-3 max-w-[12ch] text-[clamp(2.15rem,10.5vw,3.25rem)] leading-[0.94] font-bold uppercase md:mx-0 md:mb-4 md:text-[clamp(3.25rem,6vw,6rem)]">Rock desde Talcahuano</h1>
        <p class="mx-auto mb-0 max-w-[38rem] text-sm text-ash-400 sm:text-base md:mx-0">La estructura inicial del sitio está lista. El contenido oficial se incorporará cuando sea confirmado.</p>
      </div>
    </div>
  </section>
  <section class="mx-auto min-h-[48vh] w-full max-w-[70rem] px-4 pt-8 pb-12 sm:px-6 sm:pt-10 sm:pb-16 lg:px-8 lg:pt-12 lg:pb-20" aria-labelledby="fase-title">
    <h2 class="mb-3 text-xl font-bold sm:text-2xl" id="fase-title">Web oficial en construcción</h2>
    <p class="mb-0 max-w-[46rem] border border-iron-700 bg-iron-900 p-4 text-sm text-ash-400 sm:p-6 sm:text-base">
      Esta entrega establece las rutas, componentes y contratos de contenido de la Fase 1. Las secciones finales del Inicio se desarrollarán en la Fase 2.
    </p>
  </section>
</BaseLayout>
