{
  "name": "tres-raices-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "editor": "node --experimental-strip-types editor/server.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --experimental-strip-types --test tests/contracts.test.ts tests/events.test.ts tests/fixtures.test.ts tests/editor.test.ts",
    "build": "pnpm run check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "perf:production": "node scripts/performance/pagespeed.mjs",
    "perf:local": "pnpm run build && node scripts/performance/lighthouse-local.mjs",
    "perf:compare": "node scripts/performance/compare.mjs",
    "validate": "pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
